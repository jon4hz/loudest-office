---
services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:2026.9.4
    container_name: homeassistant
    restart: unless-stopped
    # discovery (mDNS/SSDP), and music assistant and the visualizer on 127.0.0.1; web UI on :8123
    network_mode: host
    volumes:
      - ./config:/config
