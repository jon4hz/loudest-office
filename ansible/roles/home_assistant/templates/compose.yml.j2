---
services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:2026.10.1@sha256:130241f28d01fa80dfa3b44f7d89781c188d8642ecab9024f079f19f9f82baa0
    container_name: homeassistant
    restart: unless-stopped
    # discovery (mDNS/SSDP), and music assistant and the visualizer on 127.0.0.1; web UI on :8123
    network_mode: host
    volumes:
      - ./config:/config
