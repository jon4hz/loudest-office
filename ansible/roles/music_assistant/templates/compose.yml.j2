---
services:
  music-assistant:
    image: ghcr.io/music-assistant/server:2.10.2
    container_name: music-assistant
    restart: unless-stopped
    # required for local player discovery (mDNS/uPnP); web UI on :8095, streams on :8097
    network_mode: host
    volumes:
      - ./data:/data
    environment:
      LOG_LEVEL: info

  sendspin:
    image: ghcr.io/music-assistant/local-audio-addon:0.1.13
    container_name: sendspin
    restart: unless-stopped
    network_mode: host
    devices:
      - /dev/snd:/dev/snd
    group_add:
      - keep-groups
    volumes:
      - ./sendspin:/data
    environment:
      SENDSPIN_NAME: loudest-office
      SENDSPIN_SERVER: 127.0.0.1:8927
      SENDSPIN_OUTPUT: alsa:hw:CARD=sndrpihifiberry,DEV=0
      SENDSPIN_ID: loudest-office

  caddy:
    image: docker.io/caddy:2.11.4
    container_name: caddy
    restart: unless-stopped
    network_mode: host
    command: caddy reverse-proxy --from {{ ansible_host }} --to localhost:8095 --internal-certs
    volumes:
      - ./caddy:/data
