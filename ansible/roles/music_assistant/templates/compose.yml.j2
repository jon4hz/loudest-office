---
services:
  music-assistant:
    image: ghcr.io/music-assistant/server:2.10.9
    container_name: music-assistant
    restart: unless-stopped
    # required for local player discovery (mDNS/uPnP); web UI on :8095, streams on :8097
    network_mode: host
    volumes:
      - ./data:/data
      # custom providers live in the server's own providers package; the python
      # version in this path is tied to the image tag above (.python-version upstream)
      - ./plugins/rabe:/app/venv/lib/python3.14/site-packages/music_assistant/providers/rabe:ro
    environment:
      LOG_LEVEL: info

  sendspin:
    image: ghcr.io/music-assistant/local-audio-addon:0.2.0
    container_name: sendspin
    restart: unless-stopped
    network_mode: host
    devices:
      - /dev/snd:/dev/snd
    group_add:
      - keep-groups
    volumes:
      - ./sendspin:/data
    environment:
      SENDSPIN_NAME: loudest-office
      # Music Assistant's stream server is bound to the LAN address (its settings,
      # core module Stream server, Bind to IP): that pins the AirPlay receiver's mDNS
      # to that interface, so its announcements don't leak the access point's address
      SENDSPIN_SERVER: "{{ ansible_default_ipv4.address }}:8927"
      SENDSPIN_OUTPUT: alsa:hw:CARD=sndrpihifiberry,DEV=0
      # sendspin-cli applies the player volume in software, without dither: on the
      # 16-bit stream Music Assistant picks by default, volume 16 leaves ~12 bits.
      # 32-bit samples keep the volume control lossless over its whole range. PCM,
      # not FLAC: Music Assistant encodes FLAC at 16 or 24 bits only and the player
      # offers no 24-bit; 3 Mbit/s raw over the loopback costs nothing.
      SENDSPIN_AUDIO_FORMAT: pcm:48000:32:2
      SENDSPIN_ID: loudest-office
