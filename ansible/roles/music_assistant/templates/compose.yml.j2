---
services:
  music-assistant:
    image: ghcr.io/music-assistant/server:2.10.8@sha256:661e88bea76a9e79f38feca791f6c7373376ab60766ee01f56b66418ca243b68
    container_name: music-assistant
    restart: unless-stopped
    # required for local player discovery (mDNS/uPnP); web UI on :8095, streams on :8097
    network_mode: host
    volumes:
      - ./data:/data
      # custom providers live in the server's own providers package; the python
      # version in this path is tied to the image tag above (.python-version upstream)
      - ./plugins/rabe:/app/venv/lib/python3.14/site-packages/music_assistant/providers/rabe:ro
    environment:
      LOG_LEVEL: info

  sendspin:
    image: ghcr.io/music-assistant/local-audio-addon:0.2.0@sha256:3497ffc3cdaa9c724c7eb672d508ff3b62e6c182d2f39702609254f954fc4b61
    container_name: sendspin
    restart: unless-stopped
    network_mode: host
    devices:
      - /dev/snd:/dev/snd
    group_add:
      - keep-groups
    volumes:
      - ./sendspin:/data
    environment:
      SENDSPIN_NAME: loudest-office
      SENDSPIN_SERVER: 127.0.0.1:8927
      SENDSPIN_OUTPUT: alsa:hw:CARD=sndrpihifiberry,DEV=0
      SENDSPIN_ID: loudest-office
