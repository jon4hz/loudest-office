# The ESP32 that drives the HUB75 panel: a stable name for the visualizer. tty devices
# carry the systemd tag already, so dev-hub75.device exists. A classic devkit's CP2102
# bridge or an ESP32-S3's native USB (USB-Serial-JTAG, /dev/ttyACM*); plug in only one.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="hub75"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="hub75"
