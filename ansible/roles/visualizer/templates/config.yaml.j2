{{ ansible_managed | comment }}
{# `| string` decrypts the vaulted token (`~` does the same for the tronbyt key): to_nice_yaml would write it back as `!vault |` + ciphertext #}
{% set ma = {'ma_url': visualizer_ma_url, 'ma_player': visualizer_ma_player, 'ma_token': visualizer_ma_token | string} if visualizer_ma_url else {} %}
{% set tronbyt = {'tronbyt': 'http://127.0.0.1:8000/' ~ visualizer_tronbyt_device ~ '/next' ~ ('?key=' ~ visualizer_tronbyt_key if visualizer_tronbyt_key | string else '')} if visualizer_tronbyt_device else {} %}
{{ visualizer_config | combine(ma, tronbyt) | to_nice_yaml }}
